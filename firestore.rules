rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && request.auth.token.role == 'platform-admin';
    }

    function isActive() {
      return isSignedIn()
        && request.auth.token.active == true;
    }

    // dealerId lives on the user document (not always on the auth token)
    function callerDealerId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data
        .dealerId;
    }

    function isCallerDealer(dealerId) {
      return isActive()
        && dealerId != null
        && dealerId != ''
        && dealerId == callerDealerId();
    }

    function docBelongsToCaller() {
      return isActive()
        && resource.data.dealerId == callerDealerId();
    }

    // Allow get on missing docs (existence checks) OR same-dealer docs
    function canReadDoc() {
      return isPlatformAdmin()
        || (isActive() && resource == null)
        || docBelongsToCaller();
    }

    function newDocBelongsToCaller() {
      return isActive()
        && request.resource.data.dealerId == callerDealerId();
    }

    function dealerIdUnchanged() {
      return request.resource.data.dealerId == resource.data.dealerId;
    }

    // =========================
    // DEALERS
    // Public read is required for the login page
    // =========================

    match /dealers/{dealerId} {
      allow read: if true;

      allow create, update, delete: if isPlatformAdmin()
        || isCallerDealer(dealerId);

      // requestTypes and other settings under the dealer
      match /settings/{document=**} {
        allow read: if isPlatformAdmin() || isCallerDealer(dealerId);

        allow write: if isPlatformAdmin()
          || (
            isCallerDealer(dealerId)
            && request.auth.token.role in ['admin', 'manager']
          );
      }
    }

    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || docBelongsToCaller();

      allow create: if isSignedIn()
        && request.auth.uid == userId;

      allow update: if isPlatformAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || (
          docBelongsToCaller()
          && request.auth.token.role in ['admin', 'manager']
        );

      allow delete: if isPlatformAdmin();

      // FCM / device settings under this user
      match /devices/{deviceId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }
       
             // RO Tracker column settings (and other per-user module settings)
      match /moduleSettings/{settingsId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == userId;
      }

    }

    // =========================
    // DEALER-SCOPED DATA
    // =========================

    match /ros/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();

      match /{subpath=**} {
        allow read: if isPlatformAdmin()
          || (
            isActive()
            && get(/databases/$(database)/documents/ros/$(docId)).data.dealerId
              == callerDealerId()
          );

        allow write: if isPlatformAdmin()
          || (
            isActive()
            && get(/databases/$(database)/documents/ros/$(docId)).data.dealerId
              == callerDealerId()
          );
      }
    }

    match /notificationRequests/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }

    match /locations/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }

    match /valetRequests/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }

    match /washTickets/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }

    match /loaners/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }

    match /loanerReturns/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }

    match /auditLogs/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin();
    }

    // Catch-all: loanerFleet, requests, notificationGroups, etc.
    match /{collection}/{docId} {
      allow read: if canReadDoc();
      allow create: if isPlatformAdmin() || newDocBelongsToCaller();
      allow update: if isPlatformAdmin()
        || (docBelongsToCaller() && dealerIdUnchanged());
      allow delete: if isPlatformAdmin()
        || docBelongsToCaller();
    }
  }
}